    "/video/api/v1/calls/{call_id}/token": {
      "post": {
        "operationId": "video_api_v1_calls_token_create",
        "description": "``POST /calls/{id}/token`` — a fresh credential for a call in progress.\n\nA media token is presented AGAIN on every full reconnect and nothing\nre-mints it automatically, so without this endpoint the token's TTL is a\nhard ceiling on coming back from a tunnel — and the failure looks like a\nnetwork fault rather than an expiry. Live calls only: re-minting a grant\nfor a call that is over would hand out a key to a room nobody is in.\n\n**Permissions:** `IsAuthenticated`",
        "parameters": [
          {
            "in": "path",
            "name": "call_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": [
          "Video"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CallSessionRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CallSessionRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CallSessionRequest"
              }
            }
          }
        },
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaTokenResponse"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/video/api/v1/calls/active": {
      "get": {
        "operationId": "video_api_v1_calls_active_retrieve",
        "description": "``GET /video/api/v1/calls/active`` — the caller's own live call, if any.\n\nThe repair for every dropped frame: the socket is best-effort, so a lost\n``call.incoming`` would be a call that never rang and a lost\n``call.ended`` a ring that never stops. The front reads this on mount and\non every realtime reconnect (SPEC §7.1), which is what turns \"the socket\nis unreliable\" from a defect into a property.\n\n**Permissions:** `IsAuthenticated`",
        "tags": [
          "Video"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveCallResponse"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
