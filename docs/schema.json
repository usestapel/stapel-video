  "components": {
    "schemas": {
      "ActiveCallResponse": {
        "type": "object",
        "description": "This person's live call, or the absence of one.",
        "properties": {
          "call": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CallResponse"
              }
            ],
            "nullable": true,
            "description": "The live call, or null. Present-and-null rather than a 204, so"
          }
        }
      },
      "AdmitResponse": {
        "type": "object",
        "description": "The outcome of a host admit action.",
        "properties": {
          "participant": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ParticipantResponse"
              }
            ],
            "description": "The now-admitted participant"
          },
          "token": {
            "type": "string",
            "description": "The join token minted for them"
          }
        },
        "required": [
          "participant",
          "token"
        ]
      },
      "CallCreateRequest": {
        "type": "object",
        "description": "Ring somebody.",
        "properties": {
          "callee_id": {
            "type": "string",
            "description": "The person to ring"
          },
          "thread_key": {
            "type": "string",
            "description": "The chat conversation this call belongs to. The default"
          },
          "media": {
            "type": "string",
            "description": "audio / video. Defaults to video"
          },
          "client_session_id": {
            "type": "string",
            "nullable": true,
            "description": "A stable per-browser id, exactly as on"
          }
        },
        "required": [
          "callee_id"
        ]
      },
      "CallResponse": {
        "type": "object",
        "description": "One call, as both parties see it.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Call id (UUID)"
          },
          "thread_key": {
            "type": "string",
            "description": "The chat conversation this call hangs off, echoed back"
          },
          "caller_id": {
            "type": "string",
            "description": "Who rang"
          },
          "callee_id": {
            "type": "string",
            "description": "Who was rung"
          },
          "room_name": {
            "type": "string",
            "description": "The provider room ref (``call-<id>``) — the name the"
          },
          "media": {
            "type": "string",
            "description": "audio / video — what the caller asked for"
          },
          "state": {
            "type": "string",
            "description": "ringing / accepted / declined / missed / ended / failed"
          },
          "end_reason": {
            "type": "string",
            "description": "Why it stopped, \"\" while it has not"
          },
          "started_at": {
            "type": "string",
            "description": "When the ring began (ISO-8601)"
          },
          "answered_at": {
            "type": "string",
            "nullable": true,
            "description": "When it was accepted, or null"
          },
          "ended_at": {
            "type": "string",
            "nullable": true,
            "description": "When it stopped, or null"
          },
          "duration_seconds": {
            "type": "integer",
            "description": "Connected seconds — ``ended_at - answered_at``"
          },
          "expires_at": {
            "type": "string",
            "nullable": true,
            "description": "When the ring runs out, while it is ringing; null"
          }
        },
        "required": [
          "callee_id",
          "caller_id",
          "end_reason",
          "id",
          "media",
          "room_name",
          "started_at",
          "state",
          "thread_key"
        ]
      },
      "CallSessionRequest": {
        "type": "object",
        "description": "Accept a call, or re-mint its token.",
        "properties": {
          "client_session_id": {
            "type": "string",
            "nullable": true,
            "description": "See ``CallCreateRequest``"
          }
        }
      },
      "CallTokenResponse": {
        "type": "object",
        "description": "A call plus the credential and address one party dials with.",
        "properties": {
          "call": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CallResponse"
              }
            ],
            "description": "The call"
          },
          "token": {
            "type": "string",
            "description": "This party's signed media token. Never anybody else's, and"
          },
          "url": {
            "type": "string",
            "description": "The media server the token is for — where the BROWSER connects,"
          }
        },
        "required": [
          "call",
          "token",
          "url"
        ]
      },
      "JoinRequest": {
        "type": "object",
        "description": "Join a room.",
        "properties": {
          "client_session_id": {
            "type": "string",
            "nullable": true,
            "description": "A stable per-browser id the client keeps across"
          }
        }
      },
      "JoinResponse": {
        "type": "object",
        "description": "The outcome of a join attempt.",
        "properties": {
          "status": {
            "type": "string",
            "description": "admitted / waiting / denied"
          },
          "room": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RoomResponse"
              }
            ],
            "description": "The room joined"
          },
          "participant": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ParticipantResponse"
              }
            ],
            "description": "The caller's participant row"
          },
          "token": {
            "type": "string",
            "nullable": true,
            "description": "A signed join token (only when status == admitted)"
          }
        },
        "required": [
          "participant",
          "room",
          "status"
        ]
      },
      "LobbyActionRequest": {
        "type": "object",
